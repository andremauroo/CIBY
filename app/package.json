{
  "name": "ciby-app",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc -b && vite build && node scripts/build-sw.mjs",
    "preview": "vite preview --host 0.0.0.0",
    "test": "vitest run",
    "test:e2e": "npm run build && playwright test",
    "format": "prettier --write src scripts tests *.ts *.json *.html README.md",
    "phone:usb": "node scripts/phone-usb.mjs"
  },
  "dependencies": {
    "@fontsource/manrope": "^5.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.2.0",
    "prettier": "^3.10.1",
    "typescript": "^5.8.0",
    "vite": "^7.3.8",
    "vitest": "^4.1.12"
  },
  "engines": {
    "node": "^22.12.0 || >=24.0.0"
  }
}

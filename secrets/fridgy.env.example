# Copia questo file in fridgy.local.env (stessa cartella) e incolla la tua chiave.
# fridgy.local.env è escluso da Git: ogni persona del gruppo usa la propria chiave.
# Con `npm run dev` Fridgy lo legge da solo; la build e il sito pubblicato no.

# Servizio consigliato: groq. Alternative: gemini, openrouter.
FRIDGY_PROVIDER=groq
# La tua chiave personale (per Groq inizia con gsk_).
FRIDGY_API_KEY=
# Facoltativo: lascia vuoto per usare il modello consigliato,
# per esempio llama-3.3-70b-versatile.
FRIDGY_MODEL=
